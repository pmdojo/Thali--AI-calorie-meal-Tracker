# Anthropic — used by the Supabase Edge Function `analyze-meal`
ANTHROPIC_API_KEY=

# Supabase (project URL + anon key). Same values used by both apps.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — Edge Function only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=
